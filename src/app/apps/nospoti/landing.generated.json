er-surfaceBorder hover:border-zinc-500 transition-all\"\n    >\n      3. Discovery & Search\n    </button>\n    <button\n      data-action=\"switchMobileTab('library')\"\n      id=\"tab-library\"\n      class=\"mobile-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-surfaceRaised text-zinc-300 border border-surfaceBorder hover:border-zinc-500 transition-all\"\n    >\n      4. Liked Songs & Library\n    </button>\n  </div>\n\n  <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n    <div class=\"lg:col-span-5 flex justify-center\">\n      <div\n        class=\"relative w-full max-w-[340px] p-2 rounded-[3rem] doppel-shell\"\n      >\n        <div\n          class=\"rounded-[calc(3rem-0.5rem)] overflow-hidden doppel-core shadow-2xl relative\"\n        >\n          <img\n            loading=\"lazy\"\n            decoding=\"async\"\n            id=\"mobile-mockup-img\"\n            src=\"/assets/nospoti/legacy/mobile/mobile-home.jpg\"\n            alt=\"NoSpoti mobile design mockup\"\n            class=\"w-full h-auto object-cover transition-opacity duration-300\"\n          />\n        </div>\n      </div>\n    </div>\n\n    <div class=\"lg:col-span-7 space-y-6\">\n      <div class=\"p-6 rounded-2xl bg-surface border border-white/10\">\n        <div\n          class=\"flex items-center gap-2 text-lime-accent font-mono text-xs uppercase tracking-wider mb-2\"\n          id=\"flow-tag\"\n        >\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layout-grid w-4 h-4\" aria-hidden=\"true\"><rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"7\" x=\"14\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"7\" x=\"14\" y=\"14\" rx=\"1\"></rect><rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"></rect></svg>\n          <span>Interactive Flow 01</span>\n        </div>\n        <h3 class=\"text-2xl font-bold text-white mb-2\" id=\"flow-title\">\n          Your next favourite starts here\n        </h3>\n        <p class=\"text-zinc-400 text-sm leading-relaxed\" id=\"flow-description\">\n          Browse Bollywood, Punjabi, Marathi, English pop, and more. Revisit\n          favourites, explore moods, and find music for your day.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs\">\n        <div\n          class=\"p-4 rounded-xl bg-surfaceRaised border border-surfaceBorder\"\n        >\n          <div class=\"flex items-center gap-2 text-white font-bold mb-1\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-box w-4 h-4 text-lime-accent\" aria-hidden=\"true\"><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"></path><path d=\"m3.3 7 8.7 5 8.7-5\"></path><path d=\"M12 22V12\"></path></svg>\n            <span>Your music, front and centre</span>\n          </div>\n          <p class=\"text-zinc-400\">\n            A dark player with album artwork, playback controls, and a queue you\n            can shape as you listen.\n          </p>\n        </div>\n\n        <div\n          class=\"p-4 rounded-xl bg-surfaceRaised border border-surfaceBorder\"\n        >\n          <div class=\"flex items-center gap-2 text-white font-bold mb-1\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity w-4 h-4 text-lime-accent\" aria-hidden=\"true\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg>\n            <span>Lyrics, when available</span>\n          </div>\n          <p class=\"text-zinc-400\">\n            Open Lyrics from the full player. Some tracks include timed lyrics;\n            others have plain text or no match.\n          </p>\n        </div>\n\n        <div\n          class=\"p-4 rounded-xl bg-surfaceRaised border border-surfaceBorder\"\n        >\n          <div class=\"flex items-center gap-2 text-white font-bold mb-1\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-radio w-4 h-4 text-lime-accent\" aria-hidden=\"true\"><path d=\"M4.9 19.1C1 15.2 1 8.8 4.9 4.9\"></path><path d=\"M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5\"></path><circle cx=\"12\" cy=\"12\" r=\"2\"></circle><path d=\"M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5\"></path><path d=\"M19.1 4.9C23 8.8 23 15.1 19.1 19\"></path></svg>\n            <span>Discover across sources</span>\n          </div>\n          <p class=\"text-zinc-400\">\n            Search connected music sources and explore curated moods and\n            languages. Availability varies by track and source.\n          </p>\n        </div>\n\n        <div\n          class=\"p-4 rounded-xl bg-surfaceRaised border border-surfaceBorder\"\n        >\n          <div class=\"flex items-center gap-2 text-white font-bold mb-1\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hard-drive w-4 h-4 text-lime-accent\" aria-hidden=\"true\"><line x1=\"22\" x2=\"2\" y1=\"12\" y2=\"12\"></line><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path><line x1=\"6\" x2=\"6.01\" y1=\"16\" y2=\"16\"></line><line x1=\"10\" x2=\"10.01\" y1=\"16\" y2=\"16\"></line></svg>\n            <span>Your library, your way</span>\n          </div>\n          <p class=\"text-zinc-400\">\n            Listen as a guest, or sign in for cloud library sync. Device files\n            remain on the device where you added them.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"pt-2\">\n        <a\n          href=\"https://no-spoti.vercel.app/app/\"\n          class=\"inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold bg-white/10 hover:bg-white/20 text-white transition-all active:scale-[0.98]\"\n        >\n          <span>Try This Screen in Web Player</span>\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-3.5 h-3.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg>\n        </a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section\n  id=\"features\"\n  class=\"py-24 px-6 max-w-7xl mx-auto border-t border-white/[0.08]\"\n>\n  <div class=\"mb-14\">\n    <h2\n      class=\"text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-3\"\n    >\n      Less interruption. More listening.\n    </h2>\n    <p class=\"text-zinc-400 max-w-2xl text-sm md:text-base\">\n      Keep the songs you love close, discover a different sound, and share a\n      listening session with someone who gets it.\n    </p>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n    <div class=\"md:col-span-2 p-1.5 rounded-[2rem] doppel-shell\">\n      <div\n        class=\"p-8 rounded-[calc(2rem-0.375rem)] doppel-core flex flex-col justify-between h-full relative overflow-hidden group\"\n      >\n        <div class=\"relative z-10\">\n          <div\n            class=\"w-10 h-10 rounded-xl bg-lime-muted text-lime-accent flex items-center justify-center mb-6\"\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layers w-5 h-5\" aria-hidden=\"true\"><path d=\"m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z\"></path><path d=\"m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65\"></path><path d=\"m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65\"></path></svg>\n          </div>\n          <h3 class=\"text-2xl font-bold text-white mb-2\">\n            Search, save, and press play\n          </h3>\n          <p class=\"text-zinc-400 text-sm max-w-xl leading-relaxed mb-6\">\n            Search music, import public Spotify or YouTube playlists, and add\n            supported audio files from your device. Imports bring track lists\n            into NoSpoti; playback depends on finding an available source.\n          </p>\n\n          <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs\">\n            <div\n              class=\"p-3 rounded-xl bg-surfaceRaised border border-surfaceBorder\"\n            >\n              <div class=\"font-bold text-white\">Music discovery</div>\n              <div class=\"text-[11px] text-zinc-400 mt-1\">\n                Source-dependent quality\n              </div>\n            </div>\n            <div\n              class=\"p-3 rounded-xl bg-surfaceRaised border border-surfaceBorder\"\n            >\n              <div class=\"font-bold text-white\">JioSaavn</div>\n              <div class=\"text-[11px] text-zinc-400 mt-1\">Music search</div>\n            </div>\n            <div\n              class=\"p-3 rounded-xl bg-surfaceRaised border border-surfaceBorder\"\n            >\n              <div class=\"font-bold text-white\">Playlist imports</div>\n              <div class=\"text-[11px] text-zinc-400 mt-1\">Track matching</div>\n            </div>\n            <div\n              class=\"p-3 rounded-xl bg-surfaceRaised border border-surfaceBorder\"\n            >\n              <div class=\"font-bold text-white\">Device Files</div>\n              <div class=\"text-[11px] text-zinc-400 mt-1\">\n                Supported audio files\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"p-1.5 rounded-[2rem] doppel-shell\">\n      <div\n        class=\"rounded-[calc(2rem-0.375rem)] doppel-core overflow-hidden flex flex-col h-full group\"\n      >\n        <div class=\"h-48 overflow-hidden relative\">\n          <img\n            loading=\"lazy\"\n            decoding=\"async\"\n            src=\"/assets/nospoti/legacy/waveform-bento.jpg\"\n            alt=\"Acoustic waveform analytics\"\n            class=\"w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500\"\n          />\n          <div\n            class=\"absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent\"\n          ></div>\n        </div>\n        <div class=\"p-6 pt-2 flex-1 flex flex-col justify-between\">\n          <div>\n            <h3 class=\"text-lg font-bold text-white mb-2\">\n              A player that keeps up\n            </h3>\n            <p class=\"text-zinc-400 text-xs leading-relaxed\">\n              Pause, skip, seek, and manage what plays next. Similar-song\n              autoplay looks for different songs that fit the artist, album, or\n              mood.\n            </p>\n          </div>\n          <div\n            class=\"pt-4 font-mono text-[11px] text-lime-accent flex items-center gap-1.5\"\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-3.5 h-3.5\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n            <span>Playback quality depends on the source</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"p-1.5 rounded-[2rem] doppel-shell\">\n      <div\n        class=\"p-6 rounded-[calc(2rem-0.375rem)] doppel-core flex flex-col justify-between h-full\"\n      >\n        <div>\n          <div\n            class=\"w-10 h-10 rounded-xl bg-lime-muted text-lime-accent flex items-center justify-center mb-6\"\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database w-5 h-5\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg>\n          </div>\n          <h3 class=\"text-lg font-bold text-white mb-2\">\n            Local library. Optional cloud sync.\n          </h3>\n          <p class=\"text-zinc-400 text-xs leading-relaxed mb-4\">\n            Guest listening keeps your library on the device. When you sign in,\n            supported library data can sync through Supabase. Clearing browser\n            data may remove local files and downloads.\n          </p>\n        </div>\n        <div\n          class=\"p-3 rounded-xl bg-surfaceRaised border border-surfaceBorder font-mono text-xs text-zinc-300\"\n        >\n          <div class=\"text-lime-accent font-bold\">\n            Guest listening supported\n          </div>\n          <div class=\"text-[11px] text-zinc-400 mt-1\">\n            Sign in for supported cloud sync\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"md:col-span-2 p-1.5 rounded-[2rem] doppel-shell\">\n      <div\n        class=\"p-8 rounded-[calc(2rem-0.375rem)] doppel-core flex flex-col justify-between h-full relative overflow-hidden\"\n      >\n        <div>\n          <div\n            class=\"w-10 h-10 rounded-xl bg-lime-muted text-lime-accent flex items-center justify-center mb-6\"\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart w-5 h-5\" aria-hidden=\"true\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"></path></svg>\n          </div>\n          <h3 class=\"text-2xl font-bold text-white mb-2\">\n            Your favourites, ready for another listen\n          </h3>\n          <p class=\"text-zinc-400 text-sm max-w-xl leading-relaxed mb-6\">\n            Tap the heart to save a song in Liked Songs. Build your own\n            playlists, import a collection, or explore mixes and genre\n            collections from Home.\n          </p>\n        </div>\n\n        <div\n          class=\"flex flex-wrap items-center gap-3 text-xs font-mono text-zinc-300\"\n        >\n          <span\n            class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surfaceRaised border border-surfaceBorder\"\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkle w-3.5 h-3.5 text-lime-accent\" aria-hidden=\"true\"><path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"></path></svg>\n            Liked Songs\n          </span>\n          <span\n            class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surfaceRaised border border-surfaceBorder\"\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-list-music w-3.5 h-3.5 text-lime-accent\" aria-hidden=\"true\"><path d=\"M21 15V6\"></path><path d=\"M18.5 18a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z\"></path><path d=\"M12 12H3\"></path><path d=\"M16 6H3\"></path><path d=\"M12 18H3\"></path></svg>\n            Custom playlists\n          </span>\n          <span\n            class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surfaceRaised border border-surfaceBorder\"\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shuffle w-3.5 h-3.5 text-lime-accent\" aria-hidden=\"true\"><path d=\"M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22\"></path><path d=\"m18 2 4 4-4 4\"></path><path d=\"M2 6h1.9c1.5 0 2.9.9 3.6 2.2\"></path><path d=\"M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8\"></path><path d=\"m18 14 4 4-4 4\"></path></svg>\n            Shuffle & queue\n          </span>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section\n  id=\"compare\"\n  class=\"py-24 px-6 max-w-7xl mx-auto border-t border-white/[0.08]\"\n>\n  <div class=\"mb-12 text-center\">\n    <h2 class=\"text-3xl md:text-4xl font-extrabold text-white mb-4\">\n      What you can do today.\n    </h2>\n    <p class=\"text-zinc-400\">\n      A clear look at the features, and where availability varies.\n    </p>\n  </div>\n  <div class=\"p-1.5 rounded-[2rem] doppel-shell\">\n    <div class=\"overflow-x-auto rounded-3xl doppel-core\">\n      <table class=\"w-full text-left text-sm\">\n        <caption class=\"sr-only\">\n          NoSpoti feature availability\n        </caption>\n        <thead class=\"text-xs uppercase bg-surfaceRaised text-zinc-400\">\n          <tr>\n            <th class=\"p-5\">Feature</th>\n            <th class=\"p-5\">Availability</th>\n            <th class=\"p-5\">What to know</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr class=\"border-b border-surfaceBorder\">\n            <th scope=\"row\" class=\"p-4 sm:p-5 text-white font-semibold\">\n              Listening\n            </th>\n            <td class=\"p-4 sm:p-5 text-lime-accent\">Free to use</td>\n            <td class=\"p-4 sm:p-5 text-zinc-400\">\n              NoSpoti does not insert ads into its player.\n            </td>\n          </tr>\n          <tr class=\"border-b border-surfaceBorder\">\n            <th scope=\"row\" class=\"p-4 sm:p-5 text-white font-semibold\">\n              Library\n            </th>\n            <td class=\"p-4 sm:p-5 text-lime-accent\">Available</td>\n            <td class=\"p-4 sm:p-5 text-zinc-400\">\n              Liked Songs, custom playlists, and supported cloud sync when\n              signed in.\n            </td>\n          </tr>\n          <tr class=\"border-b border-surfaceBorder\">\n            <th scope=\"row\" class=\"p-4 sm:p-5 text-white font-semibold\">\n              Playlist imports\n            </th>\n            <td class=\"p-4 sm:p-5 text-lime-accent\">Available</td>\n            <td class=\"p-4 sm:p-5 text-zinc-400\">\n              Import public Spotify and supported YouTube playlist links. Tracks\n              need an available playback match.\n            </td>\n          </tr>\n          <tr class=\"border-b border-surfaceBorder\">\n            <th scope=\"row\" class=\"p-4 sm:p-5 text-white font-semibold\">\n              Jam rooms\n            </th>\n            <td class=\"p-4 sm:p-5 text-lime-accent\">Available</td>\n            <td class=\"p-4 sm:p-5 text-zinc-400\">\n              One host controls playback. Listeners join with a room code;\n              everyone needs internet.\n            </td>\n          </tr>\n          <tr class=\"border-b border-surfaceBorder\">\n            <th scope=\"row\" class=\"p-4 sm:p-5 text-white font-semibold\">\n              Lyrics\n            </th>\n            <td class=\"p-4 sm:p-5 text-lime-accent\">\n              When a match is available\n            </td>\n            <td class=\"p-4 sm:p-5 text-zinc-400\">\n              Timed or plain lyrics depend on the song and the lyrics service.\n            </td>\n          </tr>\n          <tr class=\"border-b border-surfaceBorder\">\n            <th scope=\"row\" class=\"p-4 sm:p-5 text-white font-semibold\">\n              Offline listening\n            </th>\n            <td class=\"p-4 sm:p-5 text-lime-accent\">\n              For files available on your device\n            </td>\n            <td class=\"p-4 sm:p-5 text-zinc-400\">\n              Downloads depend on source and browser support. Online search and\n              Jam need internet.\n            </td>\n          </tr>\n          <tr class=\"border-b border-surfaceBorder\">\n            <th scope=\"row\" class=\"p-4 sm:p-5 text-white font-semibold\">\n              Android & web\n            </th>\n            <td class=\"p-4 sm:p-5 text-lime-accent\">Available</td>\n            <td class=\"p-4 sm:p-5 text-zinc-400\">\n              The APK is for Android. iPhone, tablet, and desktop users can open\n              the web player.\n            </td>\n          </tr>\n          <tr class=\"border-b border-surfaceBorder\">\n            <th scope=\"row\" class=\"p-4 sm:p-5 text-white font-semibold\">\n              AI DJ & MCP\n            </th>\n            <td class=\"p-4 sm:p-5 text-lime-accent\">\n              Experimental / off in the public app\n            </td>\n            <td class=\"p-4 sm:p-5 text-zinc-400\">\n              Developer integration work is in the repository. Installing the\n              app alone does not connect an AI assistant.\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n\n<section\n  id=\"listen-together\"\n  class=\"py-24 px-6 max-w-7xl mx-auto border-t border-white/[0.08]\"\n>\n  <div class=\"mb-12\">\n    <span class=\"text-xs font-mono text-lime-accent uppercase tracking-widest\"\n      >Listen together</span\n    >\n    <h2 class=\"text-3xl md:text-5xl font-extrabold text-white mt-4 mb-4\">\n      Different places.<br />The same song.\n    </h2>\n    <p class=\"text-zinc-400 max-w-2xl leading-relaxed\">\n      Start a Jam, share the room code, and listen with your partner or friends.\n      The host chooses the music while listeners follow the shared queue.\n    </p>\n  </div>\n  <div class=\"grid lg:grid-cols-2 gap-8\">\n    <div class=\"doppel-shell rounded-[2rem] p-2\">\n      <div class=\"doppel-core rounded-3xl p-7 sm:p-10\">\n        <span class=\"text-xs text-lime-accent font-mono\"\n          >JAM ROOM PREVIEW · ILLUSTRATION</span\n        >\n        <div class=\"flex items-center gap-3 mt-8 mb-6\">\n          <span class=\"w-3 h-3 rounded-full bg-lime-accent\"></span\n          ><strong class=\"text-white text-lg\"\n            >Your room. Your soundtrack.</strong\n          >\n        </div>\n        <div class=\"bg-obsidian rounded-2xl p-5 border border-surfaceBorder\">\n          <span class=\"text-zinc-400 text-xs\">SHARE A PRIVATE ROOM CODE</span>\n          <p class=\"text-4xl tracking-widest text-white font-bold mt-3\">\n            PLAY01\n          </p>\n        </div>\n        <div class=\"flex gap-3 items-center mt-6 text-zinc-300\">\n          <i data-lucide=\"headphones\" class=\"w-5 h-5 text-lime-accent\"></i\n          ><span>One host · Everyone listening</span>\n        </div>\n        <a\n          class=\"inline-flex items-center gap-3 mt-8 px-6 py-3 rounded-full bg-lime-accent text-obsidian font-bold\"\n          href=\"https://no-spoti.vercel.app/app/jam\"\n          >Open Jam <i data-lucide=\"arrow-up-right\" class=\"w-4 h-4\"></i\n        ></a>\n      </div>\n    </div>\n    <div class=\"space-y-6\">\n      <div class=\"doppel-core rounded-3xl p-7\">\n        <h3 class=\"text-xl font-bold text-white mb-3\">\n          Make a little room for someone.\n        </h3>\n        <ol class=\"text-zinc-400 leading-relaxed space-y-3 list-decimal pl-5\">\n          <li>Open Jam in the app and choose your display name.</li>\n          <li>Create a room, then share its code with your listeners.</li>\n          <li>Pick a song. The host controls play, pause, skip, and seek.</li>\n        </ol>\n        <p class=\"text-xs text-zinc-500 mt-5\">\n          Each device streams its own audio. Internet and available song sources\n          are required; timing can vary with the connection.\n        </p>\n      </div>\n      <div id=\"mcp\" class=\"doppel-core rounded-3xl p-7\">\n        <span class=\"text-xs text-lime-accent uppercase font-mono\"\n          >Experimental · Not enabled in the public app</span\n        >\n        <h3 class=\"text-xl font-bold text-white mt-3 mb-3\">\n          MCP for developers.\n        </h3>\n        <p class=\"text-zinc-400 text-sm leading-relaxed\">\n          The repository includes developer work for connecting compatible AI\n          assistants to music tools. It needs a configured bridge and a\n          supported client. There is no built-in AI chat or API key required for\n          normal listening.\n        </p>\n        <a\n          href=\"https://github.com/Aniketchavan7/No-Spoti/tree/staging/mcp\"\n          class=\"inline-flex items-center gap-2 text-lime-accent text-sm mt-5\"\n          >Explore the MCP source\n          <i data-lucide=\"arrow-up-right\" class=\"w-4 h-4\"></i\n        ></a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section\n  id=\"download-apk\"\n  class=\"py-24 px-6 max-w-7xl mx-auto border-t border-white/[0.08]\"\n>\n  <div class=\"text-center max-w-2xl mx-auto mb-12\">\n    <span class=\"text-xs font-mono text-lime-accent uppercase\"\n      >Android & Web</span\n    >\n    <h2 class=\"text-3xl md:text-5xl text-white font-extrabold my-4\">\n      Your next song.<br />Right here.\n    </h2>\n    <p class=\"text-zinc-400\">\n      Choose an Android download or open the player in your browser.\n    </p>\n  </div>\n  <div class=\"grid md:grid-cols-2 gap-6\">\n    <article class=\"doppel-shell rounded-[2rem] p-2\">\n      <div class=\"doppel-core rounded-3xl p-8 h-full flex flex-col\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-smartphone w-8 h-8 text-lime-accent mb-5\" aria-hidden=\"true\"><rect width=\"14\" height=\"20\" x=\"5\" y=\"2\" rx=\"2\" ry=\"2\"></rect><path d=\"M12 18h.01\"></path></svg>\n        <h3 class=\"text-2xl font-bold text-white mb-3\">\n          Take the music with you.\n        </h3>\n        <p class=\"text-zinc-400 leading-relaxed mb-7\">\n          Install the available NoSpoti APK on an Android phone. This download\n          is separate from the web player and may be on a different release.\n        </p>\n        <a\n          class=\"mt-auto inline-flex justify-center items-center gap-3 bg-lime-accent text-obsidian rounded-full px-6 py-4 font-bold\"\n          href=\"https://no-spoti.vercel.app/No-Spoti.apk\"\n          >Download Android APK <i data-lucide=\"download\" class=\"w-4 h-4\"></i\n        ></a>\n        <p class=\"text-xs text-zinc-500 mt-4\">\n          Direct APK download · Android only\n        </p>\n      </div>\n    </article>\n    <article class=\"doppel-shell rounded-[2rem] p-2\">\n      <div class=\"doppel-core rounded-3xl p-8 h-full flex flex-col\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-8 h-8 text-lime-accent mb-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg>\n        <h3 class=\"text-2xl font-bold text-white mb-3\">Open a new tab.</h3>\n        <p class=\"text-zinc-400 leading-relaxed mb-7\">\n          Listen from an Android phone, iPhone, tablet, or desktop browser. No\n          native iPhone app is required.\n        </p>\n        <a\n          class=\"mt-auto inline-flex justify-center items-center gap-3 border border-white/20 text-white rounded-full px-6 py-4 font-bold hover:border-lime-accent\"\n          href=\"https://no-spoti.vercel.app/app/\"\n          >Launch web player <i data-lucide=\"arrow-up-right\" class=\"w-4 h-4\"></i\n        ></a>\n        <p class=\"text-xs text-zinc-500 mt-4\">\n          No installation needed · Features vary by browser\n        </p>\n      </div>\n    </article>\n  </div>\n</section>\n\n<section\n  id=\"architecture\"\n  class=\"py-24 px-6 max-w-7xl mx-auto border-t border-white/[0.08]\"\n>\n  <h2 class=\"text-3xl md:text-4xl text-white font-extrabold mb-8\">\n    Before you press play.\n  </h2>\n  <div class=\"space-y-4\">\n    <details class=\"doppel-core rounded-2xl p-6\">\n      <summary class=\"font-bold text-white cursor-pointer\">\n        Do I need an account or AI API key?\n      </summary>\n      <p class=\"mt-4 text-zinc-400 leading-relaxed max-w-3xl\">\n        You can listen as a guest. An account is used for supported cloud\n        library sync. Normal music listening does not require an AI API key.\n      </p>\n    </details>\n    <details class=\"doppel-core rounded-2xl p-6\">\n      <summary class=\"font-bold text-white cursor-pointer\">\n        Will every imported song play?\n      </summary>\n      <p class=\"mt-4 text-zinc-400 leading-relaxed max-w-3xl\">\n        Playlist imports bring song information into your library. Playback\n        needs an available matching source, so some tracks may be unavailable.\n      </p>\n    </details>\n    <details class=\"doppel-core rounded-2xl p-6\">\n      <summary class=\"font-bold text-white cursor-pointer\">\n        Can I listen without internet?\n      </summary>\n      <p class=\"mt-4 text-zinc-400 leading-relaxed max-w-3xl\">\n        Only audio already available on your device can play offline. Online\n        searches, new streams, account sync, and Jam rooms need internet.\n      </p>\n    </details>\n    <details class=\"doppel-core rounded-2xl p-6\">\n      <summary class=\"font-bold text-white cursor-pointer\">\n        Are these app screenshots?\n      </summary>\n      <p class=\"mt-4 text-zinc-400 leading-relaxed max-w-3xl\">\n        The large hero and mobile images are design mockups from the original\n        NoSpoti landing page. The current app may look different.\n      </p>\n    </details>\n    <details class=\"doppel-core rounded-2xl p-6\">\n      <summary class=\"font-bold text-white cursor-pointer\">\n        How is my data stored?\n      </summary>\n      <p class=\"mt-4 text-zinc-400 leading-relaxed max-w-3xl\">\n        Guest library data is stored locally. Signed-in accounts use Supabase\n        for supported account and library data. Account and library sync uses\n        network requests to Supabase; local file storage depends on your\n        browser.\n      </p>\n    </details>\n  </div>\n</section>\n\n<section class=\"py-28 px-6 max-w-5xl mx-auto text-center\">\n  <div\n    class=\"p-10 sm:p-16 rounded-[2.5rem] doppel-shell relative overflow-hidden\"\n  >\n    <div\n      class=\"rounded-[calc(2.5rem-0.625rem)] doppel-core p-8 sm:p-12 relative overflow-hidden\"\n    >\n      <div\n        class=\"absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-lime-accent/15 rounded-full blur-[100px] pointer-events-none\"\n      ></div>\n\n      <h2\n        class=\"text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4 relative z-10 text-balance\"\n      >\n        Put something good on.\n      </h2>\n      <p\n        class=\"text-zinc-400 max-w-xl mx-auto text-sm sm:text-base mb-10 relative z-10\"\n      >\n        Open the web player on your phone or computer, or download the Android\n        APK. Pick a song. Bring someone along.\n      </p>\n\n      <div\n        class=\"flex flex-wrap items-center justify-center gap-4 relative z-10\"\n      >\n        <a\n          href=\"https://no-spoti.vercel.app/app/\"\n          id=\"final-launch-btn\"\n          class=\"inline-flex items-center gap-3 pl-8 pr-2.5 py-2.5 rounded-full text-base font-bold bg-lime-accent text-obsidian hover:bg-lime-hover shadow-glow transition-all active:scale-[0.98] group\"\n        >\n          <span>Open web player</span>\n          <div\n            class=\"w-10 h-10 rounded-full bg-obsidian text-lime-accent flex items-center justify-center transition-transform group-hover:scale-105 group-hover:translate-x-0.5\"\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play w-4 h-4 fill-lime-accent stroke-[2]\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"></polygon></svg>\n          </div>\n        </a>\n        <a\n          href=\"#download-apk\"\n          class=\"inline-flex items-center gap-2 px-6 py-4 rounded-full text-base font-semibold bg-surfaceRaised hover:bg-surfaceBorder text-zinc-200 border border-surfaceBorder transition-all active:scale-[0.98]\"\n        >\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-download w-4 h-4 text-lime-accent\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"7 10 12 15 17 10\"></polyline><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"></line></svg>\n          <span>Download Android .APK</span>\n        </a>\n        <a\n          href=\"/apps\"\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          class=\"inline-flex items-center gap-2 px-6 py-4 rounded-full text-base font-semibold bg-surfaceRaised hover:bg-surfaceBorder text-zinc-200 border border-surfaceBorder transition-all active:scale-[0.98]\"\n        >\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link w-4 h-4 text-lime-accent\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg>\n          <span>aniketchavan.in/apps</span>\n        </a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<footer\n  class=\"border-t border-white/[0.08] py-12 px-6 max-w-7xl mx-auto text-xs text-zinc-400 flex flex-col sm:flex-row items-center justify-between gap-6\"\n>\n  <div class=\"flex items-center gap-3\">\n    <img\n      loading=\"lazy\"\n      decoding=\"async\"\n      src=\"/assets/nospoti/legacy/logo.png\"\n      alt=\"NoSpoti\"\n      class=\"w-8 h-8 rounded-full object-cover border border-white/20\"\n    />\n    <span class=\"text-zinc-300 font-semibold\">NoSpoti</span>\n    <span>•</span>\n    <span>Open-source music player</span>\n    <span>•</span>\n    <a\n      href=\"/apps\"\n      target=\"_blank\"\n      rel=\"noopener noreferrer\"\n      class=\"text-lime-accent hover:underline\"\n      >aniketchavan.in/apps</a\n    >\n  </div>\n\n  <div class=\"flex flex-wrap items-center gap-6\">\n    <a\n      href=\"/apps\"\n      target=\"_blank\"\n      rel=\"noopener noreferrer\"\n      class=\"hover:text-white transition-colors\"\n      >Aniket's Apps</a\n    >\n    <a\n      href=\"https://github.com/Aniketchavan7/No-Spoti\"\n      class=\"hover:text-white transition-colors\"\n      >GitHub Repository</a\n    >\n    <a\n      href=\"https://no-spoti.vercel.app/app/\"\n      class=\"hover:text-white transition-colors\"\n      >Web Player (iOS/Browser)</a\n    >\n    <a href=\"#listen-together\" class=\"hover:text-white transition-colors\"\n      >Jam &amp; MCP</a\n    >\n    <a href=\"#download-apk\" class=\"hover:text-white transition-colors\"\n      >Android .APK</a\n    >\n  </div>\n</footer>\n"