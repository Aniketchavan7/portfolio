 <div class=\"text-sm font-bold text-white\">\n              A look inside NoSpoti\n            </div>\n            <div class=\"text-xs text-zinc-400\">\n              Search • Playlists • Lyrics • Listen together\n            </div>\n          </div>\n        </div>\n        <a\n          href=\"https://no-spoti.vercel.app/app/\"\n          class=\"px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-xs font-semibold text-white transition-colors\"\n        >\n          Open App Demo &rarr;\n        </a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section\n  id=\"live-demo\"\n  class=\"py-24 px-6 max-w-7xl mx-auto border-t border-white/[0.08]\"\n>\n  <div\n    class=\"flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6\"\n  >\n    <div>\n      <h2\n        class=\"text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-3\"\n      >\n        A little preview. Press play.\n      </h2>\n      <p class=\"text-zinc-400 max-w-xl text-sm md:text-base\">\n        Try three short demo sounds and explore the player controls. These\n        samples are a preview; open the web app to search for music.\n      </p>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <span\n        class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-lime-muted text-lime-accent border border-lime-accent/30\"\n      >\n        <span\n          class=\"w-1.5 h-1.5 rounded-full bg-lime-accent animate-ping\"\n        ></span>\n        Interactive audio demo\n      </span>\n    </div>\n  </div>\n\n  <div class=\"p-2 sm:p-3 rounded-[2.2rem] doppel-shell\">\n    <div class=\"rounded-[calc(2.2rem-0.75rem)] doppel-core p-6 md:p-8\">\n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n        <div\n          class=\"lg:col-span-5 flex flex-col items-center justify-center p-6 bg-surfaceRaised rounded-2xl border border-surfaceBorder relative overflow-hidden\"\n        >\n          <canvas\n            id=