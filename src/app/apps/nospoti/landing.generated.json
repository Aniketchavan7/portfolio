n                >\n              </button>\n              <button\n                data-action=\"switchTrack(2)\"\n                class=\"track-btn flex flex-col text-left p-3.5 rounded-xl bg-surfaceRaised border border-surfaceBorder text-zinc-300 transition-all hover:bg-surfaceBorder text-xs\"\n                data-index=\"2\"\n              >\n                <span class=\"font-bold\">Slow Bloom</span>\n                <span class=\"text-zinc-400 text-[11px] mt-0.5\"\n                  >Ambient Lo-Fi Chill</span\n                >\n              </button>\n            </div>\n          </div>\n\n          <div>\n            <div\n              class=\"w-full bg-surfaceBorder h-2 rounded-full overflow-hidden cursor-pointer relative\"\n              id=\"scrubber-bar\"\n              role=\"slider\"\n              tabindex=\"0\"\n              aria-label=\"Demo playback position\"\n              aria-valuemin=\"0\"\n              aria-valuemax=\"100\"\n              aria-valuenow=\"0\"\n              data-action=\"seekAudio(event)\"\n            >\n              <div\n                id=\"progress-bar\"\n                class=\"bg-lime-accent h-full w-0 transition-all duration-100\"\n              ></div>\n            </div>\n            <div\n              class=\"flex justify-between items-center text-[11px] font-mono text-zinc-400 mt-2\"\n            >\n              <span id=\"time-current\">0:00</span>\n              <span id=\"time-total\">0:02</span>\n            </div>\n          </div>\n\n          <div\n            class=\"flex items-center justify-between pt-2 border-t border-surfaceBorder\"\n          >\n            <div class=\"flex items-center gap-3\">\n              <button\n                id=\"play-btn\"\n                aria-label=\"Play demo audio\"\n                data-action=\"togglePlay()\"\n                class=\"w-12 h-12 rounded-full bg-lime-accent hover:bg-lime-hover text-obsidian flex items-center justify-center transition-transform active:scale-95 shadow-glow\"\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play w-5 h-5 fill-obsidian stroke-[2.5] ml-0.5\" id=\"play-icon\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"></polygon></svg>\n              </button>\n              <div class=\"text-left ml-2\">\n                <div\n                  class=\"text-sm font-bold text-white\"\n                  id=\"playback-status\"\n                  aria-live=\"polite\"\n                >\n                  Click Play to Listen\n                </div>\n                <div class=\"text-xs text-zinc-400\">\n                  Short audio demo • Not a live music stream\n                </div>\n              </div>\n            </div>\n\n            <div class=\"flex items-center gap-3\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 w-4 h-4 text-zinc-400\" aria-hidden=\"true\"><polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon><path d=\"M15.54 8.46a5 5 0 0 1 0 7.07\"></path><path d=\"M19.07 4.93a10 10 0 0 1 0 14.14\"></path></svg>\n              <input\n                type=\"range\"\n                id=\"volume-slider\"\n                aria-label=\"Demo volume\"\n                min=\"0\"\n                max=\"1\"\n                step=\"0.05\"\n                value=\"0.8\"\n                class=\"w-20 accent-lime-accent cursor-pointer\"\n              />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section\n  id=\"mobile-showcase\"\n  class=\"py-24 px-6 max-w-7xl mx-auto border-t border-white/[0.08]\"\n>\n  <div cl